[include mainsail.cfg]
[include macros.cfg]

[include {{ printer.model }}.cfg]
[include {{ printer.name }}.cfg]

{% for name, serial in printer.mcus.items() %}
[mcu{% if name != 'main' %} {{ name }}{% endif %}]
serial: {{ serial }}

{% endfor %}
[save_variables]
filename: ~/printer_data_{{ printer.name }}/config/variables.cfg

